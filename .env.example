# Kataribe — クラウド LLM ナレーター設定の雛形
# このファイルを .env にコピーして値を埋める。.env は gitignore 済 (キーは絶対にコミットしない)。

# LLM エンドポイント (末尾 /v1 まで)
#   OpenAI:    https://api.openai.com/v1
#   Anthropic: https://api.anthropic.com/v1   (自動でネイティブ Messages API + prompt caching)
#   Meta:      https://api.llama.com/compat/v1 (OpenAI 互換の口。tool_choice は "auto" のみ = 自動判定)
#   Perplexity: https://api.perplexity.ai/v1    (自動で OpenAI Responses 形 /v1/responses。下の節)
#   ローカル:  http://localhost:11434/v1      (Ollama 等)
LLM_BASE_URL=https://api.openai.com/v1

# ワイヤプロトコル (通常は設定不要 = base_url から自動判定)。
# api.anthropic.com はネイティブ Messages API (prompt caching が効き入力コストが大幅減、
# failures.md #44)、それ以外は OpenAI 互換 chat/completions。強制したい時だけ明示:
# LLM_PROVIDER=anthropic   # または openai / gemini / responses
# 自前プロキシ経由 (判定不能なホスト名) で Anthropic を話す場合は必ず明示すること
# (未指定だと OpenAI 互換に落ちる = 安全側だが caching が効かない)。

# API キー (必須)。これが無いと LlmConfig::from_env() は Config エラーを返す。
LLM_API_KEY=

# モデル。tool-use が堅いものを推奨 (例: Claude Opus 4.8 / gpt-4o)。
LLM_MODEL=gpt-4o-mini

# tool-use の切替 (既定 true)。tools 自体を受け付けないサーバ
# (さくら AI Engine / ローカル OpenAI 互換) では false にすると
# JSON 指示 + content フォールバック経路になる (failures.md #29)。
# LLM_USE_TOOLS=true

# ツール呼び出しの強さ (通常は設定不要 = base_url から自動判定 + 拒否されたら自動降格)。
#   forced … {"type":"function","function":{"name":...}} で名前指定の強制 (既定)
#   auto   … 素の "auto" だけを送る。Meta (api.llama.com) は他の値を 400 で拒む
#            (`only "auto" is supported for tool_choice` — 2026-08-08 実機)
#   off    … tools ごと送らない (LLM_USE_TOOLS=false と同義)
# 明示 > LLM_USE_TOOLS=false > 自動判定 の順。中継や自前プロキシ越しで判定できない口でも、
# 実際に tool_choice 起因の 400 を受けたらセッション内で一段降格して覚えるので、
# 手で書く必要があるのは「先回りして往復を節約したい」時だけ。
# LLM_TOOL_MODE=auto

# Gemini を使う場合 (spec 12 Phase C でネイティブ generateContent 対応):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com   (ネイティブ、自動判定)
#   LLM_MODEL=gemini-2.5-flash
# 従来の OpenAI 互換 (.../v1beta/openai/) も引き続き使える (互換 URL は自動で互換のまま)。
# 認証は x-goog-api-key ヘッダ (キーを URL に載せない)。
# 明示キャッシュ (spec 13): Gemini 3.5-flash の**暗黙**キャッシュは総プロンプト ~8000 トークンで
# 止まる (failures #54) — 大シナリオ/長セッションで割引が効かない。既定で cachedContent に静的
# プレフィックスを pin して迂回する (Gemini 以外では無視)。作成失敗/小プレフィックスは自動で
# full request に落ちる (プレイは止まらない)。storage 課金を嫌う時のみ off:
# LLM_GEMINI_CACHE=0
# LLM_GEMINI_CACHE_TTL=900          # cachedContent の TTL 秒 (既定 900=15分。失効は透過再試行)
# LLM_GEMINI_CACHE_MIN_CHARS=4000   # 静的プレフィックスがこれ未満なら cache を作らない (サイズゲート)

# xAI (Grok) を使う場合:
#   LLM_BASE_URL=https://api.x.ai/v1
#   LLM_MODEL=grok-4.3
# tool-use 対応は schema 自己完結化 + authored 専権 op 除外で修正済 (failures.md 参照)。
# grok-4.3/4.5 には reasoning_effort を**既定で明示送出**する (spec 12 Phase D:
# 4.3=none / 4.5=low。未送出だと xAI 既定の思考が max_tokens を食い潰して空デルタ/
# タイムアウトになるため)。LLM_EFFORT で上書き可 (xhigh/max は high へ丸め)。
# 壊れ ops (move to:adjust_stat 等) が残るなら LLM_USE_TOOLS=false との A/B で切り分ける。
# キャッシュは自動だがサーバ単位 — x-grok-conv-id はクライアントが自動送信する (#45)。

# Perplexity (Agent API) を使う場合 (2026-08-20):
#   LLM_BASE_URL=https://api.perplexity.ai/v1
#   LLM_MODEL=perplexity/deepseek-v4-flash-0731     (vendor/model 表記。openai/… anthropic/… も可)
# Perplexity には /chat/completions の口が**無い** (互換経路で叩くと 404・本文なし)。
# 互換の口は Router API (https://api.perplexity.ai/router/v1) だが有料クレジットが要る (403)。
# 鍵だけで通るのは Agent API の OpenAI Responses 互換別名 /v1/responses で、api.perplexity.ai は
# 自動でそちら (provider=responses) になる。/router/ を含む base_url は互換のまま。
# tool_choice は "required" だけが効く (名指しは黙殺) — 提示ツールが emit_delta 1 本なので等価。
# 鍵の名は Kataribe では LLM_API_KEY (公式文書の PERPLEXITY_API_KEY ではない)。
# 他の OpenAI Responses 形の口 (自前プロキシ等) に使う時は LLM_PROVIDER=responses を明示。

# キャッシュ計測を stderr に出す (全プロバイダ)。cached/cache_read > 0 なら効いている。
# LLM_CACHE_DEBUG=1

# 推論の深さ (spec 12 Phase B、opt-in)。設定時のみ Anthropic ネイティブ経路で
# thinking: adaptive + output_config.effort を送る (low / medium / high / xhigh / max)。
# **注意**: Claude 系の max_tokens は思考+本文の合算上限 — effort 設定時は
# LLM_MAX_TOKENS を 16000 以上 (xhigh/max は 64000 目安) に上げること (起動時に警告が出る)。
# LLM_EFFORT=high

# あらすじ要約 (spec 10)。章あらすじの圧縮だけを別モデルに回せる。
# MODEL か BASE_URL のどちらかを書くと有効になり、書かなかった欄は GM 設定を継承する
# (provider は実効 URL から再判定)。何も書かなければ GM の client を共用する。
# SUMMARY_LLM_MODEL=gemini-2.5-flash
# SUMMARY_LLM_BASE_URL=https://generativelanguage.googleapis.com
# SUMMARY_LLM_API_KEY=
#
# 要約 1 回のタイムアウト秒 (既定 60)。圧縮は受理ターン直後に**同期**で走るので、これは
# そのままプレイの待ち時間になる。遅いモデルで毎ターン失敗するなら上げる — 失敗し続けると
# 未圧縮の経緯が溜まり、3 回目の失敗で機械的な要約に落ちて先へ進む (failures.md #87)。
# SUMMARY_LLM_TIMEOUT_SECS=60

# 任意 (既定値あり)
# LLM_TEMPERATURE: 設定すると送信する。**新しめのモデル (claude-opus-4-8 等) は
# temperature 非対応で 400 を返す**ため、既定では送らない (コメントアウトのまま)。
# 旧来モデルで温度を効かせたい時だけ有効化する (LLM_EFFORT との併用は不可 = 対象モデルが 400)。
# LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT_SECS=120
LLM_MAX_RETRIES=3
